{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "${file}",
                "-std=gnu++20",
                "-O2",
                "-Wall",
                "-I",
                "/home/uribo/atcoder/ac-library",
                "-o",
                "${fileDirname}/a.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Debug Compile",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-std=gnu++20",
                "-O0",
                "-g",
                "-Wall",
                "-I",
                "/home/uribo/atcoder/ac-library",
                "${file}",
                "-o",
                "${fileDirname}/test.out"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        }

    ]
}
